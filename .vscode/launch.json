{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Server/bin/Debug/net10.0/Server.dll",
      "cwd": "${workspaceFolder}/Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7279;http://localhost:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)"
      }
    },
    {
      "name": "Client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Client/bin/Debug/net10.0/Client.dll",
      "args": ["client-config.json"],
      "cwd": "${workspaceFolder}/Client",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Server + Client",
      "configurations": ["Server", "Client"]
    }
  ]
}
